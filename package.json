{
  "name": "@yuumi/blog",
  "version": "0.14.54",
  "private": true,
  "scripts": {
    "build": "npm run fuse && npm run build:ssg && npm run rss",
    "build:edgeone": "pnpm run sync:music-covers && pnpm run build",
    "build:spa": "pnpm run check:music && valaxy build",
    "build:ssg": "pnpm run check:music && valaxy build --ssg",
    "check:music": "jiti edge-functions/check-music-architecture.ts",
    "fuse": "valaxy fuse",
    "dev": "NODE_USE_ENV_PROXY=1 valaxy",
    "new": "valaxy new",
    "rss": "valaxy rss",
    "serve": "vite preview",
    "sync:music-covers": "jiti edge-functions/sync-music-covers.ts"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "markdown": "^0.5.0",
    "valaxy": "1.0.0-rc.12",
    "valaxy-addon-bangumi": "^0.4.0",
    "valaxy-addon-components": "^0.1.0",
    "valaxy-addon-face": "^0.2.0",
    "valaxy-addon-lightgallery": "^0.0.4",
    "valaxy-addon-moments": "^0.1.4",
    "valaxy-addon-waline": "^0.2.1",
    "valaxy-theme-yun": "1.0.0-rc.12"
  },
  "devDependencies": {
    "@iconify-json/arcticons": "^1.2.58",
    "@iconify-json/ri": "^1.2.10",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "jiti": "2.7.0",
    "sharp": "^0.34.4",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "pnpm@10.13.1"
}
